# Token du bot (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=

# ID de l'application (Developer Portal > General Information > Application ID)
CLIENT_ID=

# ID du serveur de dev (clic droit sur le serveur > Copier l'identifiant).
# Si renseigné : les commandes sont déployées instantanément sur ce serveur.
# Si vide : déploiement global (peut prendre jusqu'à 1h à propager).
GUILD_ID=

# Rôle donné automatiquement aux membres dont le compte Capital Board est lié.
# Le rôle de prod est déjà dans src/config.js — ne renseigner ici que pour tester
# sur un autre serveur (clic droit sur le rôle > Copier l'identifiant).
# Le rôle du bot doit être AU-DESSUS de ce rôle dans la hiérarchie du serveur.

# Chemin vers la clé service account Firebase Admin (.json) déposée sur la VM.
# Firebase Console > Paramètres > Comptes de service > Générer une clé privée.
# Ce fichier ne doit JAMAIS être commité (repo public). chmod 600 sur la VM.
# Laisser vide tant que les commandes Firestore ne sont pas activées.
FIREBASE_SERVICE_ACCOUNT=./firebase-key.json

# Salon où poster les alertes ops (quotas API externes — voir lib/ops-alerts.js
# et scripts/daily-recap.js). Active mode développeur Discord (Paramètres >
# Avancés), puis clic droit sur le salon > Copier l'identifiant du salon.
# Laisser vide désactive l'écoute (juste un warning au démarrage du bot).
OPS_ALERTS_CHANNEL_ID=

# Déclenchement du workflow d'application des correctifs de sécurité proposés
# par le scan (voir src/lib/scan-patches.js). Jeton GitHub fine-grained sur
# arrmel-capitalboard/Capital-Board, avec Actions: read and write et
# Contents: read and write. Sans lui, les boutons « Appliquer » renvoient une
# erreur au lieu d'agir en silence.
GITHUB_DISPATCH_TOKEN=
GITHUB_REPO=arrmel-capitalboard/Capital-Board

# Depot PRIVE de la chaine de securite : il porte le parcours d'audit et les
# workflows d'analyse, qui decrivent comment contourner les defenses de l'app.
# C'est la que se declenchent les analyses, donc le jeton ci-dessus doit porter
# l'acces aux DEUX depots.
GITHUB_SECURITY_REPO=arrmel-capitalboard/capitalboard-securite

# Clone local de ce depot prive sur la VM. Vide : on le cherche a cote du depot
# public (~/capitalboard-securite si le public est ~/Capital-Board).
DEPOT_SECURITE=

# ── Audit automatisé (scripts/run-automated-audit.mjs) ────────────────────
# Compte CapitalBoard DÉDIÉ aux tests, distinct du compte principal : le
# parcours automatisé écrit de vraies données (watchlist, tri, etc.).
# Le script refuse de démarrer si l'email désigne le compte administrateur.
BURP_TEST_ACCOUNT_EMAIL=
BURP_TEST_ACCOUNT_PASSWORD=
# Optionnel : code PIN du compte de test, s'il en a un.
BURP_TEST_ACCOUNT_PIN=
# Identifiant d'appareil stable du runner. N'importe quel UUID fixe convient :
# l'app reconnaît un appareil par cette valeur (rangée dans le localStorage),
# et l'orchestrateur la déclare de confiance avant chaque run. Sans valeur
# stable, l'app enverrait un code par email à chaque connexion.
BURP_TEST_DEVICE_ID=
# Optionnel : port et profil du proxy d'interception (défauts 8080, /tmp).
BURP_PROXY_PORT=8080
BURP_PROFIL_DIR=/tmp/cb-audit-profil
# Jeton de débogage App Check. À générer une fois (uuidgen) puis à enregistrer
# dans la console Firebase : App Check → l'app web → Gérer les jetons de
# débogage. Sans lui, reCAPTCHA v3 refuse le navigateur piloté (403 à l'échange
# content-firebaseappcheck) et le trafic applicatif part sans attestation.
# Quiconque détient ce jeton contourne App Check : il reste sur la VM, et se
# révoque depuis la même page de la console.
BURP_APPCHECK_DEBUG_TOKEN=

# Clé de chiffrement des captures automatisées (AES-256-GCM), 32 octets en
# hexadécimal : openssl rand -hex 32
# La même valeur doit exister en secret du dépôt GitHub sous le nom
# BURP_CAPTURE_KEY, sinon le workflow ne pourra pas relire la capture.
# Sans elle, la capture part en clair dans Discord — caviardée, mais lisible.
BURP_CAPTURE_KEY=
