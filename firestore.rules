rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function _isVerified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    // Deux conditions cumulées : le rôle en base ET l'uid attendu. Le rôle seul
    // laissait une deuxième définition de l'admin coexister avec l'`ADMIN_UID`
    // codé dans le client et le Worker — un document `roles` marqué superadmin
    // aurait ouvert tous les droits Firestore. Ajouter un second administrateur
    // demande donc de modifier cette ligne, volontairement.
    function _isAdmin() {
      return request.auth != null
        && request.auth.uid == 'A6nZQ8PcxdURytSesA17xK81I9T2'
        && get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == 'superadmin';
    }
    function _isSelf(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Le document de l'utilisateur et ses sous-collections sont privés. Les
    // chemins sont énumérés au lieu d'un `{path=**}` global : il faut pouvoir
    // exclure `data/trustedDevices` de l'écriture client, et une règle large
    // qui autorise l'emporte toujours sur une règle étroite qui refuse.
    match /users/{uid} {
      allow read: if _isSelf(uid);
      allow write: if _isVerified() && _isSelf(uid);
    }

    match /users/{uid}/data/{docId} {
      allow read: if _isSelf(uid);
      // trustedDevices est écrit uniquement par le Worker, après vérification du
      // code envoyé par email. Sinon il suffisait de s'inscrire soi-même comme
      // appareil de confiance pour ne jamais voir la 2FA.
      //
      // security ne porte plus de secret : le condensat du code PIN vit dans
      // pinSecrets/{uid}, écrit par le Worker (/set-pin). Le client n'y touche
      // plus que la dérogation administrateur.
      //
      // On compare les clés *modifiées* et non le document résultant : les
      // comptes pas encore migrés portent encore pinHash/pinSalt, et un
      // `hasOnly` sur le résultat leur refuserait toute écriture.
      // loginLog est le journal des connexions, ecrit par le Worker : un
      // attaquant qui detient la session ne doit pas pouvoir effacer ses traces.
      // Il reste lisible par son proprietaire (regle `read` ci-dessus).
      allow create: if _isVerified() && _isSelf(uid)
        && !(docId in ['trustedDevices','loginLog'])
        && (docId != 'security' || request.resource.data.keys().hasOnly(
             ['adminOptOut','adminOptOutAt']));
      allow update: if _isVerified() && _isSelf(uid)
        && !(docId in ['trustedDevices','loginLog'])
        && (docId != 'security' || request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['adminOptOut','adminOptOutAt']));
      allow delete: if _isVerified() && _isSelf(uid)
        && !(docId in ['trustedDevices','loginLog']);
    }

    // Signalements d'erreur envoyés depuis un module de l'app. Le bot Discord
    // les écoute et les poste dans son salon de suivi ; il passe par le SDK
    // admin, qui ignore ces règles — d'où un client qui ne fait qu'écrire.
    //
    // Aucune lecture, pas même par son auteur : le contenu est déjà chez lui
    // quand il l'envoie, et une collection lisible deviendrait un annuaire des
    // emails de tous ceux qui ont signalé quelque chose. La modification et la
    // suppression sont fermées pour la même raison — un signalement posté dans
    // Discord ne peut plus être rappelé.
    match /signalements/{id} {
      allow read, update, delete: if false;
      allow create: if _isVerified()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.texte is string
        && request.resource.data.texte.size() >= 10
        && request.resource.data.texte.size() <= 2000
        && request.resource.data.module is string
        && request.resource.data.module.size() <= 60;
    }

    match /users/{uid}/ideaVotes/{ideaId} {
      allow read: if _isSelf(uid);
      allow write: if _isVerified() && _isSelf(uid);
    }

    match /roles/{uid} {
      // Lecture limitée à soi et à l'admin. Ouverte à tout compte connecté, elle
      // laissait énumérer nom, prénom, pseudo et jeton push de tous les membres.
      // La disponibilité d'un pseudo se demande au Worker (/username-available).
      allow read: if _isSelf(uid) || _isAdmin();
      allow create: if _isAdmin() || (_isSelf(uid)
        && request.resource.data.keys().hasOnly(['firstName','lastName','username','avatarHue','fcmToken','mustChangePassword','role'])
        && (!('role' in request.resource.data) || request.resource.data.role == 'user'));
      allow update: if _isAdmin() || (_isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['firstName','lastName','username','avatarHue','fcmToken','mustChangePassword'])
        && (!('role' in request.resource.data) || request.resource.data.role == 'user'));
      allow delete: if _isAdmin();
    }

    // Questionnaire de bienvenue et avancement de la visite guidée. Un doc par
    // compte, écrit par son seul titulaire ; l'admin le lit pour connaître les
    // profils inscrits. Les clés sont énumérées : ce doc ne doit pas devenir un
    // fourre-tout écrit librement par le client.
    match /profiles/{uid} {
      allow read: if _isSelf(uid) || _isAdmin();
      allow create, update: if _isSelf(uid)
        && request.resource.data.keys().hasOnly([
             'experience','goal','wrappers','amount','expectation','source',
             'completedAt','skippedAt','skipCount','tourDoneAt','tourSkippedAt',
             'updatedAt','v',
           ]);
      allow delete: if _isAdmin() || _isSelf(uid);
    }

    // Réservation d'unicité des noms d'utilisateur. Lecture ouverte aux comptes
    // connectés ; toute écriture appartient au Worker (Admin SDK, hors règles),
    // qui réserve à la création du pseudo et libère l'ancien lors d'un changement.
    match /usernames/{name} {
      allow read: if request.auth != null;
      // Aucune écriture client : le Worker (/change-username) réserve et libère.
      // La création côté client n'était utilisée par rien et permettait de
      // squatter autant de pseudos qu'on voulait.
      allow create, update, delete: if false;
    }

    // Index inversé des abonnements aux résultats : earningsSubscribers/{sym}/users/{uid}.
    // Le script earnings-notify (Admin SDK) le parcourt pour notifier le jour J.
    // Il n'avait aucune règle, donc l'abonnement était refusé en silence : le membre
    // se croyait abonné et n'était jamais prévenu.
    //
    // Chacun ne gère que sa propre entrée, et personne ne peut lister les abonnés
    // d'un titre — la lecture est limitée à sa propre ligne.
    match /earningsSubscribers/{sym}/users/{uid} {
      allow read: if _isSelf(uid) || _isAdmin();
      allow create, update: if _isVerified() && _isSelf(uid)
        && request.resource.data.keys().hasOnly(['name','at'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80;
      allow delete: if _isVerified() && _isSelf(uid);
    }

    match /presence/{uid} {
      allow read: if request.auth != null;
      allow write: if _isVerified() && _isSelf(uid);
    }

    match /config/{doc} {
      allow read: if true;
      allow write: if _isAdmin();
    }

    match /auditLog/{id} {
      allow read: if _isAdmin();
      allow create: if _isAdmin();
    }

    function _threadFields() {
      return ['closed','archived','reason','ticketId','createdAt','closedAt',
              'closedBy','reopenedAt','lastAt','lastFrom','unreadAdmin',
              'unreadUser','userEmail','userName'];
    }

    match /supportChats/{userId}/messages/{msgId} {
      allow read: if request.auth != null && (_isSelf(userId) || _isAdmin());
      // L'utilisateur ne peut écrire qu'en son nom : autorisé sur 'system', il
      // pouvait fabriquer de faux messages de l'application.
      allow create: if _isVerified() && ((_isSelf(userId) && request.resource.data.from == 'user') || (_isAdmin() && request.resource.data.from in ['admin', 'system']));
      allow update: if _isVerified() && (_isSelf(userId) || _isAdmin()) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if _isAdmin();
    }

    match /supportThreads/{userId} {
      allow read: if request.auth != null && (_isSelf(userId) || _isAdmin());
      // L'admin écrit librement. L'utilisateur est borné aux champs de son propre
      // fil : sans cette liste, il pouvait poser un `lastAt` dans le futur et
      // rester en permanence en tête de la file de support.
      // create et update sont séparés : à la création `resource` est nul, et
      // `diff(resource.data)` y provoquerait une erreur, donc un refus.
      allow create: if _isAdmin() || (_isVerified() && _isSelf(userId)
        && request.resource.data.keys().hasOnly(_threadFields()));
      allow update: if _isAdmin() || (_isVerified() && _isSelf(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(_threadFields()));
      allow delete: if _isAdmin();
    }

    // ── Mur à idées ────────────────────────────────────────────────────────
    // Un membre propose (status 'pending'), un admin publie ou refuse, tout le
    // monde vote sur les idées publiées.
    //
    // Le vote lui-même est stocké dans users/{uid}/ideaVotes/{ideaId} (privé,
    // couvert par la règle users plus haut). Les compteurs up/down/score sont
    // dénormalisés sur l'idée pour permettre le tri par score sans lire tous
    // les votes ; ils ne sont acceptés que si le doc de vote de l'appelant
    // change de façon cohérente dans la même transaction — d'où getAfter.
    // Sans ce contrôle, n'importe qui pourrait incrémenter le score en boucle.

    // Pseudo réel de l'appelant, ou 'membre' s'il n'en a pas — exactement ce que
    // le client envoie. Empêche de publier une idée sous le nom d'un autre.
    function _usernameOf(uid) {
      return exists(/databases/$(database)/documents/roles/$(uid))
        ? get(/databases/$(database)/documents/roles/$(uid)).data.get('username', 'membre')
        : 'membre';
    }

    function _myVote(ideaId) {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)/ideaVotes/$(ideaId))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)/ideaVotes/$(ideaId)).data.v : 0;
    }
    function _myVoteAfter(ideaId) {
      return existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)/ideaVotes/$(ideaId))
        ? getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/ideaVotes/$(ideaId)).data.v : 0;
    }

    match /ideas/{ideaId} {
      // Les idées publiées sont lisibles par tout compte connecté. Une idée en
      // attente ou refusée n'est visible que de son auteur et de l'admin : les
      // requêtes client doivent donc filtrer sur status ou authorUid.
      allow read: if request.auth != null
        && (resource.data.status == 'published'
            || _isSelf(resource.data.authorUid)
            || _isAdmin());

      allow create: if _isVerified()
        && request.resource.data.keys().hasOnly(
             ['title','body','authorUid','authorName','status','createdAt','up','down','score'])
        && _isSelf(request.resource.data.authorUid)
        && request.resource.data.authorName == _usernameOf(request.auth.uid)
        && request.resource.data.status == 'pending'
        && request.resource.data.up == 0
        && request.resource.data.down == 0
        && request.resource.data.score == 0
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 2000;

      // Modération : seul l'admin change le statut ou pose un motif de refus.
      allow update: if _isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status','rejectReason','moderatedAt']);

      // Vote : uniquement les compteurs, uniquement sur une idée publiée, et
      // seulement du delta que justifie le changement du propre vote de l'appelant.
      allow update: if _isVerified()
        && resource.data.status == 'published'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['up','down','score'])
        && request.resource.data.up == resource.data.up
             + ((_myVoteAfter(ideaId) == 1 ? 1 : 0) - (_myVote(ideaId) == 1 ? 1 : 0))
        && request.resource.data.down == resource.data.down
             + ((_myVoteAfter(ideaId) == -1 ? 1 : 0) - (_myVote(ideaId) == -1 ? 1 : 0))
        && request.resource.data.score == request.resource.data.up - request.resource.data.down;

      // L'auteur peut retirer sa proposition tant qu'elle n'est pas publiée.
      allow delete: if _isAdmin()
        || (_isVerified() && _isSelf(resource.data.authorUid) && resource.data.status == 'pending');
    }

  }
}
